{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "rate(veyra_requests_total[5m])", "legendFormat": "requests", "refId": "A" }
      ],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "rate(veyra_proxy_errors_total[5m])", "legendFormat": "proxy errors", "refId": "A" },
        { "expr": "rate(veyra_auth_failures_total[5m])", "legendFormat": "auth failures", "refId": "B" },
        { "expr": "rate(veyra_ratelimit_exceeded_total[5m])", "legendFormat": "rate limited", "refId": "C" }
      ],
      "title": "Error rates",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        { "expr": "veyra_destinations_healthy", "refId": "A" }
      ],
      "title": "Healthy destinations",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "id": 4,
      "targets": [
        { "expr": "veyra_destinations_ejected", "refId": "A" }
      ],
      "title": "Ejected destinations",
      "type": "stat"
    }
  ],
  "schemaVersion": 39,
  "tags": ["veyra", "gateway"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Veyra Golden Signals",
  "uid": "veyra-golden-signals",
