{
  "$schema": "./schemas/veyra.schema.json",
  "ARTR": {
    "Veyra": {
      "Admin": {
        "Enabled": true,
        "PathBase": "/_veyra",
        "RequireAuthentication": false
      },
      "Authentication": {
        "Enabled": false,
        "Jwt": {
          "Enabled": false,
          "RequireHttpsMetadata": true
        },
        "ApiKey": {
          "Enabled": false,
          "HeaderName": "X-Api-Key",
          "Keys": []
        }
      },
      "Authorization": {
        "Enabled": false,
        "Policies": {}
      },
      "RateLimiting": {
        "Enabled": true,
        "GlobalPermitLimit": 1000,
        "GlobalWindowSeconds": 60,
        "Policies": [
          {
            "Name": "strict",
            "PermitLimit": 60,
            "WindowSeconds": 60,
            "QueueLimit": 0
          }
        ]
      },
      "RequestLimits": {
        "MaxRequestBodyBytes": 10485760,
        "RequestHeadersTimeoutSeconds": 30,
        "KeepAliveTimeoutSeconds": 120
      },
      "ForwardedHeaders": {
        "Enabled": false,
        "KnownProxies": [],
        "KnownNetworks": [],
        "ForwardLimit": 1
      },
      "Tls": {
        "UseHttpsRedirection": false
      },
      "Observability": {
        "ServiceName": "ARTR.Veyra",
        "ConsoleLogging": true,
        "Otlp": {
          "Enabled": false,
          "Endpoint": "http://127.0.0.1:4317"
        },
        "Prometheus": {
          "Enabled": false,
          "Path": "/metrics"
        }
      },
      "Secrets": {
        "Providers": [
          { "Type": "environment" },
          { "Type": "configuration" }
        ]
      },
      "Health": {
        "Enabled": true,
        "LivePath": "/health/live",
        "ReadyPath": "/health/ready",
        "StartupPath": "/health/startup"
      },
      "Transforms": {
        "Allowlist": []
      },
      "RoutingSecurity": {
        "DenyAnonymousRoutesByDefault": true
      },
      "TrafficEngineering": {
        "ValidateClusterWeights": true,
        "SafeRetries": {
          "Enabled": false,
          "MaxAttempts": 2,
          "TotalTimeoutSeconds": 10,
          "IdempotentMethods": ["GET", "HEAD", "OPTIONS"]
        },
        "OutlierDetection": {
          "Enabled": true,
          "ConsecutiveFailureEjectionThreshold": 5,
          "EjectionDurationSeconds": 30
        },
        "Hedging": {
          "Enabled": false,
          "DelayMilliseconds": 50,
          "MaxHedges": 1
        }
      },
      "Canary": {
        "Enabled": true,
        "Splits": [
          {
            "Name": "default",
            "ClusterId": "cluster-canary",
            "Weights": {
              "stable": 90,
              "canary": 10
            }
          }
        ]
      },
      "Features": {
        "Enabled": [],
        "Plugins": {
          "Enabled": false,
          "AllowedRoot": "",
          "Entries": []
        }
      },
      "Shutdown": {
        "ShutdownTimeoutSeconds": 30
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "upstream-a": {
        "ClusterId": "cluster-a",
        "Match": {
          "Path": "/a/{**catch-all}"
        },
        "Metadata": {
          "AllowAnonymous": "true"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "upstream-b": {
        "ClusterId": "cluster-b",
        "Match": {
          "Path": "/b/{**catch-all}"
        },
        "Metadata": {
          "AllowAnonymous": "true",
          "RateLimitPolicy": "strict"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "canary": {
        "ClusterId": "cluster-canary",
        "Match": {
          "Path": "/canary/{**catch-all}"
        },
        "Metadata": {
          "AllowAnonymous": "true"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "cluster-a": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5101/"
          }
        }
      },
      "cluster-b": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5102/"
          }
        }
      },
      "cluster-canary": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "stable": {
            "Address": "http://127.0.0.1:5101/",
            "Metadata": { "Weight": "90" }
          },
          "canary": {
            "Address": "http://127.0.0.1:5102/",
            "Metadata": { "Weight": "10" }
          }
        }
      }
    }
  },
  "Urls": "http://127.0.0.1:5080"
}
